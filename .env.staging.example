# ==============================================================================
# Company Employee Portal — Staging Environment Configuration Template
# Copy this file to .env.staging and populate secret values before running staging.
# NEVER commit .env.staging or production credentials to version control.
# ==============================================================================

# Application Profile
PROJECT_NAME=Company Employee Portal (Staging)
ENVIRONMENT=staging
DEBUG=false
HOST=127.0.0.1
PORT=8082

# Cryptographic Secret Key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be unique, random, and at least 32 characters long. Cannot use dev defaults.
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_SECRET

# Session & Security Settings
SESSION_COOKIE_NAME=session_id_staging
CSRF_COOKIE_NAME=csrf_token_staging
SESSION_EXPIRE_MINUTES=120
# COOKIE_SECURE: Set to true if staging is accessed over HTTPS / TLS reverse proxy.
# Set to false only for local testing over plaintext HTTP (e.g., http://localhost:8082).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Company & Localization Settings
COMPANY_TIMEZONE=Asia/Kolkata

# Isolated Staging Database Settings
# MUST target company_portal_staging. Startup will fail if pointed to company_portal.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=company_portal_staging_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_SECURE_DATABASE_PASSWORD
POSTGRES_DB=company_portal_staging

# Optional: Direct Database Connection URL override
# DATABASE_URL="postgresql+psycopg://company_portal_staging_user:postgres_staging_password_here@localhost:5432/company_portal_staging"
