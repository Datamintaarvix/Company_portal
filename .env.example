# Application Settings
PROJECT_NAME="Company Employee Portal"
ENVIRONMENT="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_SECRET

# Session & Security Settings
SESSION_COOKIE_NAME="session_id"
CSRF_COOKIE_NAME="csrf_token"
SESSION_EXPIRE_MINUTES=120
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=CHANGE_ME_USE_A_SECURE_DATABASE_PASSWORD
POSTGRES_DB="company_portal"

# Optional: Direct Database Connection URL override
# DATABASE_URL="postgresql+psycopg://postgres:postgres_password_here@localhost:5432/company_portal"
