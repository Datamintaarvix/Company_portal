# ==============================================================================
# Company Employee Portal — Production Environment Template
# Copy this file to .env.production on the production host and populate secrets.
# NEVER commit .env.production or any production credentials to version control.
# ==============================================================================

# Application Profile
PROJECT_NAME="Company Employee Portal"
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Cryptographic Secret Key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be unique, random, and at least 32 characters long.
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_SECRET

# Session & Security Settings
SESSION_COOKIE_NAME=session_id_prod
CSRF_COOKIE_NAME=csrf_token_prod
SESSION_EXPIRE_MINUTES=120
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5

RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Company & Localization Settings
COMPANY_TIMEZONE=Asia/Kolkata

# Isolated Production Database Settings
# MUST target company_portal_prod. Startup will fail if pointed to dev or staging.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=company_portal_prod_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_SECURE_DATABASE_PASSWORD
POSTGRES_DB=company_portal_prod

# Optional: Direct SQLAlchemy Connection String
# DATABASE_URL="postgresql+psycopg://company_portal_prod_user:password@db:5432/company_portal_prod"

# Domain Configuration
CADDY_DOMAIN=portal.datamintaarvix.com
